# Copy to .env (gitignored) and fill in every value. Never commit .env.
# The values are intentionally empty: docker compose refuses to start until you
# set them, and the Postgres init script rejects placeholders and passwords
# shorter than 16 characters. All three must differ.
# Generate each with:  openssl rand -base64 24
# They are applied when the Postgres volume is first created; change them later
# with ALTER ROLE ... PASSWORD (and update .env to match). If init rejected a
# weak value, fix .env and run 'docker compose down -v' before starting again.

# Postgres superuser (postgres): reachable only via docker exec, not over TCP
POSTGRES_PASSWORD=
# Generator role: owns all schemas, reachable only from the Compose network
CPGSIM_WRITER_PASSWORD=
# BI tool role: SELECT on shop, wms, erp, mkt, feeds, shelf; nothing on sim or truth
CPGSIM_READER_PASSWORD=

# Host path to a private overlay YAML FILE kept outside the repository; empty = none.
# It must exist and be a file (a missing path becomes a directory in the bind mount).
# Example: CPGSIM_OVERLAY=/path/to/private.yaml
CPGSIM_OVERLAY=

# Optional
# POSTGRES_DB=cpgsim
# CPGSIM_PG_PORT=5432
# CPGSIM_PG_BIND=0.0.0.0     # interface the published port binds to
