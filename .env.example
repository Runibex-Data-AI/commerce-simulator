# Copy to .env (gitignored) and replace every placeholder. Never commit .env.
# The three passwords are applied when the Postgres volume is first created;
# change them later with ALTER ROLE ... PASSWORD (and update .env to match).

# Postgres superuser (postgres)
POSTGRES_PASSWORD=change-me
# Generator role: owns all schemas, used only by the generator container
CPGSIM_WRITER_PASSWORD=change-me
# BI tool role: SELECT on shop, wms, erp, mkt, feeds, shelf; nothing on sim or truth
CPGSIM_READER_PASSWORD=change-me

# Host path to a private overlay YAML kept outside the repository; empty = none.
# Example: CPGSIM_OVERLAY=/path/to/private.yaml
CPGSIM_OVERLAY=

# Optional
# POSTGRES_DB=cpgsim
# CPGSIM_PG_PORT=5432
